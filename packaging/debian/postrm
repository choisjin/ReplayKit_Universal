#!/bin/sh
# postrm — ReplayKit
# 아이콘 캐시 갱신. 사용자 데이터는 보존.
set -e

case "$1" in
    remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ -x /usr/bin/gtk-update-icon-cache ]; then
            gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>/dev/null || true
        fi
        if [ -x /usr/bin/update-desktop-database ]; then
            update-desktop-database -q /usr/share/applications >/dev/null 2>/dev/null || true
        fi
        if [ "$1" = "purge" ]; then
            echo "Note: User data at ~/.local/share/ReplayKit is preserved."
            echo "      Remove manually if not needed:"
            echo "        rm -rf ~/.local/share/ReplayKit"
        fi
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
